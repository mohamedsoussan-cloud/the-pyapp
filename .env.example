# Serveur uniquement : URL de la base PostgreSQL fournie par votre hébergeur
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Générez une valeur aléatoire longue (au moins 32 caractères)
SECRET_KEY=replace-with-a-long-random-secret
# Création automatique du premier compte admin au premier démarrage
ADMIN_EMAIL=admin@votre-domaine.ma
ADMIN_PASSWORD=replace-with-a-long-password-12-chars-minimum
# true en production HTTPS
COOKIE_SECURE=true
